# This repo is developed in a container that mounts the user's Claude credentials,
# so never run dependency lifecycle scripts, and always record exact versions.
ignore-scripts=true
save-exact=true
# npm 10.9's arborist crashes ("reading 'edgesOut'") resolving vitest's optional
# browser-provider peers, and otherwise auto-installs vitest 5 for Stryker's peer range.
# All peers we need are declared explicitly in package.json.
legacy-peer-deps=true
# package.json "overrides" pins qs >= 6.16: @stryker-mutator/core -> typed-rest-client pins a
# release of qs with known denial-of-service advisories (dev tooling only, nothing ships).

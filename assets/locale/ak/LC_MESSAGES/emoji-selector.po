#: src/prefs.ts
msgid "General layout"
msgstr "Nhyehyɛe nyinaa"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Interface a ɛfiri ase no kyerɛ yɛ papa bere a wode panel a ɛwɔ ase di dwuma sen bar a ɛwɔ soro a ɛyɛ default no."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Efi soro kɔ ase"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Efi ase kɔ soro"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Wɔantumi ankora nhyehyɛe no"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Emoji dodow wɔ line biara so"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Emoji no kɛse (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Nhyehyɛe"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Modifier nkyerɛwde no ɛsɛ sɛ ɛwɔ < > mfinimfini"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Default boɔ no yɛ %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Mfa keyboard shortcut a ɛwɔ hɔ dedaw no nni dwuma."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Fa keyboard shortcut di dwuma sɛ wobɛbue na wato menu no mu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Keyboard shortcut"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Yei nyɛ keyboard shortcut a ɛfata"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Key din a ɛfata no list"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Daa daa kyerɛ icon no wɔ panel no so"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Sɛ wode keyboard shortcut no kɔ menu no mu a, ɛho nhia sɛ wokyerɛ icon no daa."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Keyboard shortcuts"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Extension yi de menu a wotumi hyehyɛ a ɛkyerɛ emoji pii ba; sɛ wopia emoji so a, ɛkopi kɔ clipboard mu."


#: src/prefs.ts
msgid "General layout"
msgstr "Cynllun cyffredinol"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Mae dangos y rhyngwyneb o'r gwaelod yn well os ydych yn defnyddio panel gwaelod yn lle'r bar uchaf rhagosodedig."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "O'r top i'r gwaelod"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "O'r gwaelod i'r top"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Doedd dim modd cadw'r gosodiad"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Nifer yr emojis ym mhob llinell"

#: src/prefs.ts
msgid "Size of emojis (px)"

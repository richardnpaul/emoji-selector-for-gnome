#: src/prefs.ts
msgid "Layout"
msgstr "Cynllun"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Rhaid i fysellau addasu fod rhwng cromfachau ongl"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Y gwerth rhagosodedig yw %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Peidiwch â defnyddio llwybr byr bysellfwrdd sy'n bodoli eisoes."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Defnyddio llwybr byr bysellfwrdd i doglo'r ddewislen"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Llwybr byr bysellfwrdd"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Nid yw hwn yn llwybr byr bysellfwrdd dilys"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Rhestr o enwau bysellau dilys"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Dangos yr eicon yn y panel bob amser"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Os ydych yn cyrchu'r ddewislen gyda'r llwybr byr bysellfwrdd, does dim angen dangos yr eicon bob amser."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Rhwymiadau bysellfwrdd"


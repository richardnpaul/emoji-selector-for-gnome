#: src/prefs.ts
msgid "General layout"
msgstr "Diseinu orokorra"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Interfazea behetik bistaratzea hobe da, goiko barra lehenetsiaren ordez beheko panela erabiltzen baduzu."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Goitik behera"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Behetik gora"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Ezin izan da ezarpena gorde"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Lerroko emoji kopurua"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Emojien tamaina (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Diseinua"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Aldatzaile-teklak parentesi angeluarren artean egon behar dute"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Balio lehenetsia %s da"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ez erabili lehendik dagoen teklatuko lasterbiderik."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Erabili teklatuko lasterbide bat menua irekitzeko eta ixteko"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Teklatuko lasterbidea"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Hau ez da baliozko teklatuko lasterbidea"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Baliozko tekla-izenen zerrenda"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Erakutsi beti ikonoa panelean"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Menua teklatuko lasterbidearekin irekitzen baduzu, ez duzu ikonoa beti bistaratu beharrik."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Teklatuko lasterbideak"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Luzapen honek emoji gehienak bistaratzen dituen laster-menu konfiguragarri bat eskaintzen du, eta emoji batean klik eginez gero arbelean kopiatzen da."


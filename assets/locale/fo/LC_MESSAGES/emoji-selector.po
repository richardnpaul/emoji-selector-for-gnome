#: src/prefs.ts
msgid "General layout"
msgstr "Almenn uppsetan"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Tað er betri at vísa brúkaraflatan niðanfrá, um tú brúkar panel niðast í staðin fyri vanligu ovastu linjuna."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ovanfrá og niðureftir"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Niðanfrá og uppeftir"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Stillingin kundi ikki goymast"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Tal av emoji á hvørjari linju"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Stødd á emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Uppsetan"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Broytiknappar mugu vera millum vinkilmerki"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Vanliga virðið er %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Brúka ikki ein snarknapp, ið longu er til."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Brúka ein snarknapp til at lata valmyndina upp og aftur"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Snarknappur"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Hetta er ikki ein gildugur snarknappur"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Listi yvir gildug knappanøvn"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Vís altíð ikonið í panelinum"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Um tú letur valmyndina upp við snarknappinum, er ikki neyðugt altíð at vísa ikonið."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Snarknappar"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."

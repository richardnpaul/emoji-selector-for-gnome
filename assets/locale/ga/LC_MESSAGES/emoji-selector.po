#: src/prefs.ts
msgid "General layout"
msgstr "Leagan amach ginearálta"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Is fearr an comhéadan a thaispeáint ón mbun má úsáideann tú painéal bun in ionad an bharra uachtaraigh réamhshocraithe."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ó bharr go bun"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Ó bhun go barr"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Níorbh fhéidir an socrú a shábháil"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Líon na n-emoji in aghaidh an líne"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Méid na n-emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Leagan amach"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Caithfidh eochracha mionathraithe a bheith idir lúibíní uilleacha"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Is é %s an luach réamhshocraithe"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ná húsáid aicearra méarchláir atá ann cheana."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Úsáid aicearra méarchláir chun an roghchlár a scoránú"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Aicearra méarchláir"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ní aicearra méarchláir bailí é seo"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Liosta d'ainmneacha eochrach bailí"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Taispeáin an deilbhín sa phainéal i gcónaí"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Má shroiseann tú an roghchlár leis an aicearra méarchláir, níl gá leis an deilbhín a thaispeáint i gcónaí."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ceangail méarchláir"


#: src/prefs.ts
msgid "General layout"
msgstr "Tsari gaba ɗaya"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Nuna mahaɗa daga ƙasa ya fi kyau idan kana amfani da panel na ƙasa maimakon na sama na asali."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Daga sama zuwa ƙasa"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Daga ƙasa zuwa sama"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Ba a iya adana saitin ba"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Adadin emoji a kowane layi"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Girman emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Tsari"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Dole ne maɓallan gyara su kasance tsakanin alamomin < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Ƙimar asali ita ce %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Kada ka yi amfani da gajeriyar hanyar allon maɓalli da ta riga ta wanzu."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Yi amfani da gajeriyar hanyar allon maɓalli don buɗewa da rufe menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Gajeriyar hanyar allon maɓalli"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Wannan ba ingantacciyar gajeriyar hanyar allon maɓalli ba ce"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Jerin ingantattun sunayen maɓalli"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Koyaushe nuna alamar a cikin panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Idan ka buɗe menu da gajeriyar hanyar allon maɓalli, ba sai ka riƙa nuna alamar koyaushe ba."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Haɗin allon maɓalli"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Wannan ƙari yana ba da menu mai tasowa da za a iya tsarawa wanda ke nuna yawancin emoji; danna emoji yana kwafe shi zuwa clipboard."


#: src/prefs.ts
msgid "General layout"
msgstr "Aranjman jeneral"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Li pi bon pou afiche entèfas la anba si w itilize yon panno anba olye de ba anlè pa default la."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Soti anlè pou ale anba"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Soti anba pou ale anlè"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Paramèt la pa t ka anrejistre"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Kantite emoji pou chak liy"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Gwosè emoji yo (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Aranjman"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Touch modifikatè yo dwe ant chevwon yo"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Valè pa default la se %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Pa itilize yon rakousi klavye ki egziste deja."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Itilize yon rakousi klavye pou louvri oswa fèmen meni an"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Rakousi klavye"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Sa a pa yon rakousi klavye ki valab"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lis non touch ki valab yo"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Toujou montre ikòn nan nan panno a"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Si w louvri meni an ak rakousi klavye a, ou pa bezwen toujou montre ikòn nan."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Rakousi klavye yo"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ekstansyon sa a bay yon meni ki ka konfigire ki montre pifò emoji yo; lè w klike sou yon emoji, li kopye l nan près-papye a."


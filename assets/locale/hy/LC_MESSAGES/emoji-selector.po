#: src/prefs.ts
msgid "General layout"
msgstr "Ընդհանուր դասավորություն"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Ինտերֆեյսը ներքևից ցուցադրելն ավելի լավ է, եթե օգտագործում եք ներքևի վահանակ՝ լռելյայն վերևի գոտու փոխարեն։"

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Վերևից ներքև"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Ներքևից վերև"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Կարգավորումը չհաջողվեց պահպանել"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Էմոջիների քանակը մեկ տողում"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Էմոջիների չափը (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Դասավորություն"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Փոփոխիչ ստեղները պետք է լինեն անկյունավոր փակագծերի մեջ"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Լռելյայն արժեքը %s է"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Մի օգտագործեք արդեն գոյություն ունեցող ստեղնային դյուրանցում։"

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Օգտագործել ստեղնային դյուրանցում՝ ցանկը բացելու և փակելու համար"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Ստեղնային դյուրանցում"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Սա վավեր ստեղնային դյուրանցում չէ"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Վավեր ստեղների անունների ցանկ"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Միշտ ցուցադրել պատկերակը վահանակում"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Եթե ցանկը բացում եք ստեղնային դյուրանցմամբ, պատկերակը միշտ ցուցադրելու կարիք չկա։"

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ստեղնային կապակցումներ"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Այս ընդլայնումը տրամադրում է կարգավորելի թռուցիկ ցանկ, որտեղ ցուցադրվում են էմոջիների մեծ մասը. էմոջիի վրա սեղմելով այն պատճենվում է փոխանակման բուֆերում։"


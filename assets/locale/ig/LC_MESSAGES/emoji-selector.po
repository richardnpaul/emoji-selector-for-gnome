#: src/prefs.ts
msgid "General layout"
msgstr "Nhazi izugbe"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Igosipụta interface site n'ala ka mma ma ọ bụrụ na ị na-eji panel dị n'ala kama ogwe dị n'elu nke ndabara."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Site n'elu ruo n'ala"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Site n'ala ruo n'elu"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Enweghị ike ichekwa ntọala ahụ"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Ọnụọgụ emoji n'ahịrị ọ bụla"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Nha emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Nhazi"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Igodo mgbanwe ga-adị n'etiti akara < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Uru ndabara bụ %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ejila ụzọ mkpirisi keyboard nke dị ugbu a."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Jiri ụzọ mkpirisi keyboard mepee ma mechie menu ahụ"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Ụzọ mkpirisi keyboard"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Nke a abụghị ụzọ mkpirisi keyboard ziri ezi"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Ndepụta aha igodo ziri ezi"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Gosipụta akara ngosi n'ime panel mgbe niile"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Ọ bụrụ na ị na-eji ụzọ mkpirisi keyboard emepe menu ahụ, ịchọghị igosipụta akara ngosi mgbe niile."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Njikọ keyboard"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ndọtị a na-enye menu pop-up enwere ike ịhazi nke na-egosi ọtụtụ emoji; ịpị emoji na-edegara ya na clipboard."


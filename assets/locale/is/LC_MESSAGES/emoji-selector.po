#: src/prefs.ts
msgid "General layout"
msgstr "Almennt útlit"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Betra er að birta viðmótið neðan frá ef þú notar neðri stiku í stað sjálfgefnu efri stikunnar."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ofan frá og niður"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Neðan frá og upp"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Ekki var hægt að vista stillinguna"

#: src/prefs.ts
msgid "Number of emojis per line"

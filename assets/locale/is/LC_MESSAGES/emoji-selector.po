#: src/prefs.ts
msgid "Layout"
msgstr "Útlit"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Breytitakkar verða að vera innan oddklofa"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Sjálfgefið gildi er %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ekki nota flýtilykil sem þegar er til."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Nota flýtilykil til að opna og loka valmyndinni"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Flýtilykill"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Þetta er ekki gildur flýtilykill"

#: src/prefs.ts
msgid "List of valid key names"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ნუ გამოიყენებთ უკვე არსებულ კლავიატურის მალსახმობს."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "გამოიყენეთ კლავიატურის მალსახმობი მენიუს გასახსნელად და დასახურად"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "კლავიატურის მალსახმობი"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "ეს კლავიატურის სწორი მალსახმობი არ არის"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "სწორი კლავიშების სახელების სია"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "ხატულის პანელზე ყოველთვის ჩვენება"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "თუ მენიუს კლავიატურის მალსახმობით ხსნით, ხატულის მუდმივად ჩვენება აუცილებელი არ არის."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "კლავიატურის მიბმები"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "ეს გაფართოება გვთავაზობს მორგებად ამომხტარ მენიუს, რომელიც ემოჯიების უმეტესობას აჩვენებს; ემოჯიზე დაწკაპუნებით ის გაცვლის ბუფერში კოპირდება."


#: src/prefs.ts
msgid "General layout"
msgstr "Rêkxistina giştî"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Eger li şûna darika jorîn a bixwerû panelek jêrîn bi kar tînin, nîşandana navrûyê ji jêr çêtir e."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ji jor ber bi jêr ve"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Ji jêr ber bi jor ve"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Mîheng nehat tomarkirin"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Hejmara emojiyan di her rêzekê de"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Mezinahiya emojiyan (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Rêkxistin"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Divê bişkojkên guhêrker di nav parantezên goşeyî de bin"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Nirxa bixwerû %s ye"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Kurtebirrek klavyeyê ya ku jixwe heye bi kar neynin."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Kurtebirra klavyeyê ji bo vekirin û girtina menuyê bi kar bîne"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Kurtebirra klavyeyê"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ev kurtebirrek klavyeyê ya derbasdar nîne"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lîsteya navên bişkojkên derbasdar"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Îkonê her tim di panelê de nîşan bide"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Heke hûn bi kurtebirra klavyeyê têkevin menuyê, ne hewce ye ku îkon her tim were nîşandan."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Girêdanên klavyeyê"


#: src/prefs.ts
msgid "General layout"
msgstr "Entegeka y'awamu"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Okulaga interface okuva wansi kisinga bulungi bw'okozesa ekipande ekya wansi mu kifo ky'olunyiriri olwa waggulu olwa bulijjo."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Okuva waggulu okukka wansi"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Okuva wansi okulinnya waggulu"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Enteekateeka tesobose kuterekebwa"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Omuwendo gwa emoji ku lunyiriri"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Obunene bwa emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Entegeka"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Ebisumuluzo ebikyusa birina okubeera wakati w'obubonero < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Omuwendo ogwa bulijjo gwe %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Tokozesa shortcut ya keyboard eriwo dda."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Kozesa shortcut ya keyboard okuggulawo n'okuggalawo menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Shortcut ya keyboard"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Eno si shortcut ya keyboard entuufu"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Olukalala lw'amannya g'ebisumuluzo ebituufu"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Laga bulijjo akabonero ku kipande"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Bw'oyingira mu menu ng'okozesa shortcut ya keyboard, tekyetaagisa kulaga bulijjo akabonero."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Shortcut za keyboard"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Extension eno ereeta menu esobola okutegekebwa eraga emoji nnyingi; okunyiga emoji kigikoppa mu clipboard."


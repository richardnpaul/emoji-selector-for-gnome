#: src/prefs.ts
msgid "General layout"
msgstr "Lolenge ya mobimba"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Kolakisa interface uta na nse eleki malamu soki ozali kosalela panneau ya nse na esika ya barre ya likolo ya ntango nyonso."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Uta likolo tii nse"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Uta nse tii likolo"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Eloko ya kobongisa ekoki kobombama te"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Motango ya emoji na molongo moko"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Monene ya emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Lolenge"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Bilembo ya modifier esengeli kozala kati na < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Motuya ya liboso ezali %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Kosalela te nzela mokuse ya clavier oyo ezali kala."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Salela nzela mokuse ya clavier mpo na kofungola to kokanga menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Nzela mokuse ya clavier"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Oyo ezali nzela mokuse ya clavier oyo ekoki te"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Liste ya nkombo ya ba touche oyo ekoki"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Lakisa ntango nyonso elilingi na panneau"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Soki ofungoli menu na nzela mokuse ya clavier, osengeli te kolakisa ntango nyonso elilingi."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ba nzela mokuse ya clavier"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Extension oyo epesi menu oyo ekoki kobongisama oyo elakisi mingi ya ba emoji; kopina na emoji ekopi yango na clipboard."


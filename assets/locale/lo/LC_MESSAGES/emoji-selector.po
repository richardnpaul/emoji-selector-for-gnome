#: src/prefs.ts
msgid "General layout"
msgstr "ໂຄງຮ່າງທົ່ວໄປ"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "ການສະແດງສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຈາກດ້ານລຸ່ມຈະດີກວ່າ ຖ້າທ່ານໃຊ້ແຖບດ້ານລຸ່ມແທນແຖບດ້ານເທິງຕາມຄ່າເລີ່ມຕົ້ນ"

#: src/prefs.ts
msgid "From top to bottom"
msgstr "ຈາກເທິງລົງລຸ່ມ"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "ຈາກລຸ່ມຂຶ້ນເທິງ"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "ບໍ່ສາມາດບັນທຶກການຕັ້ງຄ່າໄດ້"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "ຈຳນວນອີໂມຈິຕໍ່ແຖວ"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ຂະໜາດອີໂມຈິ (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "ໂຄງຮ່າງ"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "ປຸ່ມຕົວແກ້ໄຂຕ້ອງຢູ່ລະຫວ່າງວົງເລັບມຸມ"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "ຄ່າເລີ່ມຕົ້ນແມ່ນ %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ຢ່າໃຊ້ປຸ່ມລັດທີ່ມີຢູ່ແລ້ວ"

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "ໃຊ້ປຸ່ມລັດເພື່ອເປີດ/ປິດເມນູ"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "ປຸ່ມລັດ"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "ນີ້ບໍ່ແມ່ນປຸ່ມລັດທີ່ຖືກຕ້ອງ"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "ລາຍຊື່ຊື່ປຸ່ມທີ່ຖືກຕ້ອງ"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "ສະແດງໄອຄອນໃນແຖບສະເໝີ"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "ຖ້າທ່ານເຂົ້າເມນູດ້ວຍປຸ່ມລັດ ທ່ານບໍ່ຈຳເປັນຕ້ອງສະແດງໄອຄອນຕະຫຼອດເວລາ"

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "ການກຳນົດປຸ່ມແປ້ນພິມ"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "ສ່ວນຂະຫຍາຍນີ້ມີເມນູປັອບອັບທີ່ປັບແຕ່ງໄດ້ ເຊິ່ງສະແດງອີໂມຈິສ່ວນໃຫຍ່ ການຄລິກອີໂມຈິຈະສຳເນົາໄປໃສ່ຄລິບບອດ"

#: src/prefs.ts
msgid "Author"
msgstr "ຜູ້ຂຽນ"

#: src/prefs.ts
msgid "translator-credits"
msgstr "translator-credits"

#: src/prefs.ts
msgid "Translator(s)"

#: src/prefs.ts
msgid "General layout"
msgstr "Endrika ankapobeny"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Tsara kokoa ny mampiseho ny interface avy any ambany raha mampiasa panel ambany ianao fa tsy ny bara ambony mahazatra."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Avy any ambony mankany ambany"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Avy any ambany mankany ambony"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Tsy afaka notahiry ny fandrindrana"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Isan'ny emoji isaky ny andalana"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Haben'ny emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Endrika"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Tsy maintsy eo anelanelan'ny < > ny fanalahidy mpanova"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Ny sanda mahazatra dia %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Aza mampiasa lalana fohy amin'ny klavie efa misy."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Mampiasà lalana fohy amin'ny klavie hanokatra na hanidy ny menio"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Lalana fohy amin'ny klavie"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Tsy lalana fohy amin'ny klavie mety ity"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lisitry ny anaran'ny fanalahidy mety"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Asehoy foana ny kisary ao amin'ny panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Raha miditra amin'ny menio amin'ny alàlan'ny lalana fohy ianao, tsy mila asehoina foana ny kisary."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Fanendrena klavie"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ity extension ity dia manome menio azo fanamboarina mampiseho ny ankamaroan'ny emoji; ny fanindriana emoji dia mandika azy ao amin'ny clipboard."


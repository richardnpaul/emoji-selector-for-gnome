#: src/prefs.ts
msgid "General layout"
msgstr "Whakatakotoranga whānui"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "He pai ake te whakaatu i te atanga mai i raro mēnā ka whakamahia he paewhiri o raro hei utu mō te pae o runga taunoa."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Mai runga ki raro"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Mai raro ki runga"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Kāore i taea te tiaki i te tautuhinga"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Te maha o ngā emoji ia rārangi"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Te rahi o ngā emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Whakatakotoranga"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Me noho ngā pātuhi whakarerekē ki waenga i ngā chevron"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Ko te uara taunoa ko %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Kaua e whakamahi i tētahi ara poto papapātuhi kei te noho kē."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Whakamahia he ara poto papapātuhi hei huaki, hei kati rānei i te tahua"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Ara poto papapātuhi"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ehara tēnei i te ara poto papapātuhi tika"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Rārangi o ngā ingoa pātuhi tika"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Whakaatuhia tonutia te tohu ki te paewhiri"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Mēnā ka uru koe ki te tahua mā te ara poto papapātuhi, kāore koe e hiahia ki te whakaatu tonu i te tohu."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ngā ara poto papapātuhi"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ka whakaratoa e tēnei toronga he tahua e taea ana te whirihora e whakaatu ana i te nuinga o ngā emoji; ma te pāwhiri i tētahi emoji ka kape ki te clipboard."


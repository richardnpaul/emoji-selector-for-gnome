#: src/prefs.ts
msgid "General layout"
msgstr "പൊതുവായ ലേഔട്ട്"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "ഡിഫോൾട്ട് മുകളിലെ ബാറിന് പകരം താഴത്തെ പാനൽ ഉപയോഗിക്കുന്നുണ്ടെങ്കിൽ ഇന്റർഫേസ് താഴെ നിന്ന് കാണിക്കുന്നതാണ് നല്ലത്."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "മുകളിൽ നിന്ന് താഴേക്ക്"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "താഴെ നിന്ന് മുകളിലേക്ക്"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "ക്രമീകരണം സേവ് ചെയ്യാനായില്ല"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "ഓരോ വരിയിലെയും ഇമോജികളുടെ എണ്ണം"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ഇമോജികളുടെ വലുപ്പം (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "ലേഔട്ട്"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "മോഡിഫയർ കീകൾ ആംഗിൾ ബ്രാക്കറ്റുകൾക്കുള്ളിൽ ആയിരിക്കണം"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "ഡിഫോൾട്ട് മൂല്യം %s ആണ്"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "നിലവിലുള്ള ഒരു കീബോർഡ് ഷോർട്ട്കട്ട് ഉപയോഗിക്കരുത്."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "മെനു ടോഗിൾ ചെയ്യാൻ കീബോർഡ് ഷോർട്ട്കട്ട് ഉപയോഗിക്കുക"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "കീബോർഡ് ഷോർട്ട്കട്ട്"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "ഇത് സാധുവായ കീബോർഡ് ഷോർട്ട്കട്ട് അല്ല"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "സാധുവായ കീ പേരുകളുടെ പട്ടിക"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "പാനലിൽ എപ്പോഴും ഐക്കൺ കാണിക്കുക"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "കീബോർഡ് ഷോർട്ട്കട്ട് ഉപയോഗിച്ചാണ് മെനു തുറക്കുന്നതെങ്കിൽ, ഐക്കൺ എപ്പോഴും കാണിക്കേണ്ടതില്ല."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "കീബോർഡ് ബൈൻഡിംഗുകൾ"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "ഈ എക്സ്റ്റൻഷൻ മിക്ക ഇമോജികളും കാണിക്കുന്ന ക്രമീകരിക്കാവുന്ന ഒരു പോപ്പ്അപ്പ് മെനു നൽകുന്നു; ഒരു ഇമോജിയിൽ ക്ലിക്ക് ചെയ്താൽ അത് ക്ലിപ്പ്ബോർഡിലേക്ക് പകർത്തപ്പെടും."


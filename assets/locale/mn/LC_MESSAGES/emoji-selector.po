#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Өгөгдмөл утга нь %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Аль хэдийн байгаа гарын товчлолыг бүү ашиглаарай."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Цэсийг нээх, хаахад гарын товчлол ашиглах"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Гарын товчлол"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Энэ нь хүчинтэй гарын товчлол биш байна"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Хүчинтэй товчны нэрсийн жагсаалт"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Дүрсийг самбарт үргэлж харуулах"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Хэрэв та цэсэнд гарын товчлолоор хандаж байгаа бол дүрсийг үргэлж харуулах шаардлагагүй."

#: src/prefs.ts
msgid "Keyboard bindings"

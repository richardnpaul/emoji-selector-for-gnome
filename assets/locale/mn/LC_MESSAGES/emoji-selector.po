#: src/prefs.ts
msgid "General layout"
msgstr "Ерөнхий байрлал"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Хэрэв та өгөгдмөл дээд самбарын оронд доод самбар ашигладаг бол интерфейсийг доороос нь харуулах нь дээр."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Дээрээс доош"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Доороос дээш"


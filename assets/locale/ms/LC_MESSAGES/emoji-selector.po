#: src/prefs.ts
msgid "General layout"
msgstr "Reka letak am"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Memaparkan antara muka dari bawah adalah lebih baik jika anda menggunakan panel bawah dan bukannya bar atas lalai."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Dari atas ke bawah"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Dari bawah ke atas"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Tetapan tidak dapat disimpan"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Bilangan emoji setiap baris"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Saiz emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Reka letak"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Kekunci pengubah suai mestilah berada di antara kurungan sudut"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Nilai lalai ialah %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Jangan gunakan pintasan papan kekunci yang sudah wujud."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Gunakan pintasan papan kekunci untuk togol menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Pintasan papan kekunci"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ini bukan pintasan papan kekunci yang sah"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Senarai nama kekunci yang sah"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Sentiasa tunjukkan ikon dalam panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Jika anda mengakses menu dengan pintasan papan kekunci, anda tidak perlu sentiasa memaparkan ikon."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Pengikatan papan kekunci"


#: src/prefs.ts
msgid "General layout"
msgstr "Qindaa'ina waliigalaa"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Interface gad aanaa irraa agarsiisuun isa gaarii dha yoo paanaalii gadii bakka baara ol aanaa durtii fayyadamte."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ol irraa gara gadiitti"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Gad irraa gara oliitti"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Qindaa'inni kun olkaa'amuu hin dandeenye"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Lakkoofsa emoji sarara tokkoo"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Guddina emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Qindaa'ina"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Furtuuwwan jijjiiraa gidduu mallattoowwan < > jiraachuu qabu"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Gatiin durtii %s dha"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Gabaabduu kiiboordii duraanuu jiru hin fayyadamin."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Menu banuuf fi cufuuf gabaabduu kiiboordii fayyadami"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Gabaabduu kiiboordii"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Kun gabaabduu kiiboordii fudhatama qabu miti"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Tarreeffama maqaa furtuuwwanii fudhatama qabu"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Yeroo hunda mallattoo paanaalii irratti agarsiisi"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Menu gabaabduu kiiboordiitiin yoo banatte, yeroo hunda mallattoo agarsiisuun si hin barbaachisu."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Gabaabduuwwan kiiboordii"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Dabalaan kun menu qindaa'uu danda'u emoji baay'ee agarsiisu dhiheessa; emoji tuquun clipboard irratti isa koopii godha."


#: src/prefs.ts
msgid "General layout"
msgstr "ਆਮ ਲੇਆਉਟ"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "ਜੇ ਤੁਸੀਂ ਮੂਲ ਉੱਤਲੀ ਪੱਟੀ ਦੀ ਥਾਂ ਹੇਠਲਾ ਪੈਨਲ ਵਰਤਦੇ ਹੋ ਤਾਂ ਇੰਟਰਫੇਸ ਨੂੰ ਹੇਠੋਂ ਵਿਖਾਉਣਾ ਬਿਹਤਰ ਹੈ।"

#: src/prefs.ts
msgid "From top to bottom"
msgstr "ਉੱਪਰ ਤੋਂ ਹੇਠਾਂ"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "ਹੇਠਾਂ ਤੋਂ ਉੱਪਰ"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "ਸੈਟਿੰਗ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "ਪ੍ਰਤੀ ਲਾਈਨ ਇਮੋਜੀ ਦੀ ਗਿਣਤੀ"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ਇਮੋਜੀ ਦਾ ਆਕਾਰ (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "ਲੇਆਉਟ"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "ਮੌਡੀਫਾਇਰ ਕੁੰਜੀਆਂ ਕੋਣੀ ਬਰੈਕਟਾਂ ਵਿਚਕਾਰ ਹੋਣੀਆਂ ਚਾਹੀਦੀਆਂ ਹਨ"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "ਮੂਲ ਮੁੱਲ %s ਹੈ"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ਪਹਿਲਾਂ ਤੋਂ ਮੌਜੂਦ ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ ਨਾ ਵਰਤੋ।"

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "ਮੇਨੂ ਖੋਲ੍ਹਣ ਅਤੇ ਬੰਦ ਕਰਨ ਲਈ ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ ਵਰਤੋ"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "ਇਹ ਜਾਇਜ਼ ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ ਨਹੀਂ ਹੈ"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "ਜਾਇਜ਼ ਕੁੰਜੀ ਨਾਵਾਂ ਦੀ ਸੂਚੀ"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "ਆਈਕਾਨ ਨੂੰ ਹਮੇਸ਼ਾਂ ਪੈਨਲ ਵਿੱਚ ਵਿਖਾਓ"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "ਜੇ ਤੁਸੀਂ ਮੇਨੂ ਨੂੰ ਕੀਬੋਰਡ ਸ਼ਾਰਟਕੱਟ ਨਾਲ ਖੋਲ੍ਹਦੇ ਹੋ ਤਾਂ ਆਈਕਾਨ ਹਮੇਸ਼ਾਂ ਵਿਖਾਉਣ ਦੀ ਲੋੜ ਨਹੀਂ।"

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "ਕੀਬੋਰਡ ਬਾਈਡਿੰਗ"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "ਇਹ ਐਕਸਟੈਂਸ਼ਨ ਇੱਕ ਸੰਰਚਨਾਯੋਗ ਪੌਪਅੱਪ ਮੇਨੂ ਦਿੰਦੀ ਹੈ ਜੋ ਜ਼ਿਆਦਾਤਰ ਇਮੋਜੀ ਵਿਖਾਉਂਦਾ ਹੈ, ਕਿਸੇ ਇਮੋਜੀ ਉੱਤੇ ਕਲਿੱਕ ਕਰਨ ਨਾਲ ਉਹ ਕਲਿੱਪਬੋਰਡ ਉੱਤੇ ਕਾਪੀ ਹੋ ਜਾਂਦਾ ਹੈ।"


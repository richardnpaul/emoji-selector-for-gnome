#: src/prefs.ts
msgid "General layout"
msgstr "Diseño general"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Ta mihó pa mustra e interfas for di bou si bo ta usa un panel na bou en vez di e barra di riba ku ta default."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Di riba pa bou"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Di bou pa riba"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "No por a warda e konfigurashon"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Number di emoji pa liña"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Tamaño di emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Diseño"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Teklanan modifikador mester ta entre chevron"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "E balor default ta %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "No usa un kombinashon di tekla ku ya ta existí."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Usa un kombinashon di tekla pa habri òf sera e menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Kombinashon di tekla"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Esaki no ta un kombinashon di tekla válido"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lista di nòmber di tekla válido"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Mustra e ikono semper den e panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Si bo habri e menu ku e kombinashon di tekla, bo no tin ku mustra e ikono semper."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Kombinashonnan di tekla"

#: src/prefs.ts src/lib/emojiMenu.ts

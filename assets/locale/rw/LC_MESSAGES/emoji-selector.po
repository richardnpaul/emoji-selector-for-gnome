#: src/prefs.ts
msgid "General layout"
msgstr "Imiterere rusange"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Kwerekana interface uhereye hasi ni byiza niba ukoresha umurongo wo hasi (panel) aho gukoresha umurongo wo hejuru usanzwe."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Uhereye hejuru ugana hasi"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Uhereye hasi ugana hejuru"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Igenamiterere ntiryashoboye kubikwa"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Umubare wa emoji ku murongo"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Ingano ya emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Imiterere"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Utubuto twihariye tugomba kuba hagati y'ibimenyetso < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Agaciro gasanzwe ni %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ntukoreshe inzira ngufi ya clavier isanzweho."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Koresha inzira ngufi ya clavier kugira ngo ufungure cyangwa ufunge menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Inzira ngufi ya clavier"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Iyi si inzira ngufi ya clavier yemewe"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Urutonde rw'amazina y'utubuto yemewe"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Buri gihe erekana igishushanyo mu murongo (panel)"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Niba ufungura menu ukoresheje inzira ngufi ya clavier, ntukeneye kwerekana igishushanyo buri gihe."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Inzira ngufi za clavier"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Iyi extension itanga menu ishobora guhindurwa irimo emoji nyinshi, gukanda kuri emoji bikayikoporora muri clipboard."


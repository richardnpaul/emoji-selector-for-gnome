#: src/prefs.ts
msgid "General layout"
msgstr "Faatulagaga lautele"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "E sili ona lelei le faaali o le interface mai lalo pe afai e te faaaoga se panel i lalo nai lo le pito i luga masani."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Mai luga i lalo"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Mai lalo i luga"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Sa le mafai ona faasaoina le setting"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Numera o emoji i laina taʻitasi"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Lapoʻa o emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Faatulagaga"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "E tatau ona i le va o chevron ki suiga"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "O le tau masani o le %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Aua le faaaoga se ala pupuu o le keyboard ua i ai."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Faaaoga se ala pupuu o le keyboard e tatala ma tapuni ai le menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Ala pupuu o le keyboard"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "E le o se ala pupuu talafeagai o le keyboard"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lisi o igoa o ki talafeagai"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Faaali pea le ata i le panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Afai e te faaaoga le ala pupuu o le keyboard e tatala ai le menu, e te le manaʻomia le faaali pea o le ata."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ala pupuu o ki"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "O lenei faaopoopoga e maua ai se menu e mafai ona faatulagaina e faaali ai le tele o emoji; pe a kiliki i se emoji e kopi i le clipboard."


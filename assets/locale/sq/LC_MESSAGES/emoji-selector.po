#: src/prefs.ts
msgid "General layout"
msgstr "Paraqitja e përgjithshme"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Shfaqja e ndërfaqes nga poshtë është më e mirë nëse përdorni një panel të poshtëm në vend të shiritit të sipërm të parazgjedhur."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Nga lart poshtë"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Nga poshtë lart"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Rregullimi nuk u ruajt dot"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Numri i emoji-ve për rresht"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Madhësia e emoji-ve (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Paraqitja"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Tastet modifikues duhet të jenë mes kllapave këndore"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Vlera e parazgjedhur është %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Mos përdorni një shkurtore tastiere që ekziston tashmë."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Përdor një shkurtore tastiere për të hapur e mbyllur menunë"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Shkurtore tastiere"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Kjo nuk është shkurtore tastiere e vlefshme"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lista e emrave të vlefshëm të tasteve"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Shfaq gjithmonë ikonën në panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Nëse menunë e hapni me shkurtoren e tastierës, nuk ka nevojë ta shfaqni gjithmonë ikonën."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Shkurtoret e tastierës"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ky zgjerim ofron një menu kërcyese të konfigurueshme me shumicën e emoji-ve; klikimi mbi një emoji e kopjon atë në clipboard."


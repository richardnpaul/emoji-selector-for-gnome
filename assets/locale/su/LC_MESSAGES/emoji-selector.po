#: src/prefs.ts
msgid "General layout"
msgstr "Perenah umum"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Nampilkeun antarmuka ti handap leuwih hadé lamun anjeun maké panél handap tinimbang bar luhur bawaan."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Ti luhur ka handap"

#: src/prefs.ts

msgid "Modifier keys must be between chevrons"
msgstr "Tombol pangubah kudu aya di antara tanda kurung sudut"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Nilai bawaanna nyaéta %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Entong maké potong kompas kibor anu geus aya."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Maké potong kompas kibor pikeun muka/nutup ménu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Potong kompas kibor"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ieu lain potong kompas kibor anu sah"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Daptar ngaran tombol anu sah"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Salawasna témbongkeun ikon dina panél"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Lamun anjeun ngaksés ménu maké potong kompas kibor, anjeun teu kudu salawasna nampilkeun ikon."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Pangikat kibor"


#: src/prefs.ts
msgid "General layout"
msgstr "Mpangilio wa jumla"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Ni bora kuonyesha kiolesura kutoka chini ikiwa unatumia paneli ya chini badala ya upau wa juu chaguomsingi."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Kutoka juu hadi chini"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Kutoka chini hadi juu"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Mpangilio haukuweza kuhifadhiwa"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Idadi ya emoji kwa kila mstari"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Ukubwa wa emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Mpangilio"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Vitufe vya kibadilishi lazima viwe kati ya alama za < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Thamani chaguomsingi ni %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Usitumie njia ya mkato ya kibodi iliyopo tayari."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Tumia njia ya mkato ya kibodi kufungua na kufunga menyu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Njia ya mkato ya kibodi"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Hii si njia ya mkato halali ya kibodi"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Orodha ya majina halali ya vitufe"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Onyesha ikoni kwenye paneli kila wakati"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Ukifungua menyu kwa njia ya mkato ya kibodi, huhitaji kuonyesha ikoni kila wakati."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Mikato ya kibodi"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Kiendelezi hiki hutoa menyu ibukizi inayoweza kusanidiwa inayoonyesha emoji nyingi; kubofya emoji huinakili kwenye ubao wa kunakili."


#: src/prefs.ts
msgid "General layout"
msgstr "பொது தளவமைப்பு"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "இயல்பான மேல் பட்டிக்குப் பதிலாக கீழ் பேனலைப் பயன்படுத்தினால், இடைமுகத்தைக் கீழிருந்து காட்டுவது நல்லது."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "மேலிருந்து கீழ்"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "கீழிருந்து மேல்"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "அமைப்பைச் சேமிக்க இயலவில்லை"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "ஒரு வரிசைக்கான ஈமோஜிகளின் எண்ணிக்கை"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ஈமோஜிகளின் அளவு (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "தளவமைப்பு"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "மாற்றி விசைகள் கோண அடைப்புக்குறிகளுக்குள் இருக்க வேண்டும்"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "இயல்புநிலை மதிப்பு %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ஏற்கனவே உள்ள விசைப்பலகை குறுக்குவழியைப் பயன்படுத்த வேண்டாம்."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "பட்டியலை நிலைமாற்ற விசைப்பலகை குறுக்குவழியைப் பயன்படுத்தவும்"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "விசைப்பலகை குறுக்குவழி"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "இது சரியான விசைப்பலகை குறுக்குவழி அல்ல"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "சரியான விசைப் பெயர்களின் பட்டியல்"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "பேனலில் எப்போதும் சின்னத்தைக் காட்டு"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "விசைப்பலகை குறுக்குவழியால் பட்டியலைத் திறந்தால், சின்னத்தை எப்போதும் காட்ட வேண்டியதில்லை."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "விசைப்பலகை பிணைப்புகள்"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "இந்த நீட்சி பெரும்பாலான ஈமோஜிகளைக் காட்டும், கட்டமைக்கக்கூடிய ஒரு பாப்அப் பட்டியலை வழங்குகிறது; ஒரு ஈமோஜியைச் சொடுக்கினால் அது கிளிப்போர்டுக்கு நகலெடுக்கப்படும்."

#: src/prefs.ts
msgid "Author"
msgstr "ஆசிரியர்"

#: src/prefs.ts
msgid "translator-credits"
msgstr "translator-credits"

#: src/prefs.ts

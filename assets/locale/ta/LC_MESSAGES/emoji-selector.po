#: src/prefs.ts
msgid "Contributors"
msgstr "பங்களிப்பாளர்கள்"

#: src/prefs.ts
msgid "Report bugs or ideas"
msgstr "பிழைகளை அல்லது யோசனைகளைத் தெரிவிக்கவும்"

#: src/prefs.ts
msgid "About"
msgstr "பற்றி"

#: src/prefs.ts
msgid "Could not open the web page"
msgstr "வலைப்பக்கத்தைத் திறக்க இயலவில்லை"


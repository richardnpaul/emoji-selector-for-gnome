#: src/prefs.ts
msgid "General layout"
msgstr "Тарҳбандии умумӣ"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Агар ба ҷои навори болоии пешфарз панели поёнро истифода баред, намоиши интерфейс аз поён беҳтар аст."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Аз боло ба поён"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Аз поён ба боло"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Танзим захира карда нашуд"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Шумораи эмодзиҳо дар як сатр"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Андозаи эмодзиҳо (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Тарҳбандӣ"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Тугмаҳои тағйирдиҳанда бояд дар қавсҳои кунҷдор бошанд"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Қимати пешфарз — %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Миёнбури клавиатураеро, ки аллакай вуҷуд дорад, истифода набаред."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Барои кушодан ва пӯшидани меню миёнбури клавиатураро истифода баред"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Миёнбури клавиатура"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Ин миёнбури дурусти клавиатура нест"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Рӯйхати номҳои дурусти тугмаҳо"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Нишона ҳамеша дар панел намоиш дода шавад"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Агар ба меню бо миёнбури клавиатура дастрасӣ дошта бошед, ҳамеша намоиш додани нишона лозим нест."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Миёнбурҳои клавиатура"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ин васеъкунӣ менюи калкидаи танзимшавандаро пешкаш мекунад, ки аксари эмодзиҳоро нишон медиҳад, пахш кардани эмодзӣ онро ба буфери мубодила нусха мекунад."


#: src/prefs.ts
msgid "General layout"
msgstr "Thulaganyo e e kakaretsang"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Go bontsha interface go simolola kwa tlase go molemo fa o dirisa panele ya kwa tlase go na le bara ya kwa godimo e e tlwaelegileng."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Go tswa kwa godimo go ya kwa tlase"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Go tswa kwa tlase go ya kwa godimo"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Thulaganyo ga e a kgona go bolokwa"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Palo ya di-emoji mo mothalong mongwe le mongwe"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Bogolo jwa di-emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Thulaganyo"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Dinotlolo tsa modifier di tshwanetse go nna fa gare ga matshwao a < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Boleng jo bo tlwaelegileng ke %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "O se ka wa dirisa tsela e khutshwane ya keyboard e e leng gone."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Dirisa tsela e khutshwane ya keyboard go bula le go tswala menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Tsela e khutshwane ya keyboard"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Eno ga se tsela e khutshwane ya keyboard e e siameng"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lenane la maina a dinotlolo a a siameng"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Bontsha letshwao nako tsotlhe mo panele"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Fa o tsena mo menung ka tsela e khutshwane ya keyboard, ga o tlhoke go bontsha letshwao nako tsotlhe."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ditsela tse di khutshwane tsa keyboard"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Extension eno e naya menu e e fetolegang e e bontshang di-emoji tse dintsi; go kgatla emoji go e kopolola mo clipboard."


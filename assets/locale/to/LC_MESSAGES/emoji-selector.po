#: src/prefs.ts
msgid "General layout"
msgstr "Fokotuʻu fakalūkufua"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "ʻOku lelei ange ke fakahaaʻi ʻa e interface mei lalo kapau ʻoku ke ngāueʻaki ha panel ʻi lalo ʻo ʻikai ko e laine masani ʻi ʻolunga."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Mei ʻolunga ki lalo"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Mei lalo ki ʻolunga"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Naʻe ʻikai lava ke tauhi ʻa e seti"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Fika ʻo e emoji ʻi he laine kotoa"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Lahi ʻo e emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Fokotuʻu"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Kuo pau ke ʻi he vahaʻa ʻo e chevron ʻa e ngaahi key liliu"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Ko e tuʻunga masani ko e %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ʻOua naʻa ngāueʻaki ha shortcut keyboard kuo ʻi ai."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Ngāueʻaki ha shortcut keyboard ke fakaava mo tāpuni ʻa e menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Shortcut keyboard"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "ʻOku ʻikai ko ha shortcut keyboard totonu ʻeni"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lisi ʻo e ngaahi huafa key totonu"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Fakahaaʻi maʻuaipē ʻa e icon ʻi he panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Kapau ʻoku ke aʻu ki he menu ʻaki e shortcut keyboard, ʻoku ʻikai fiemaʻu ke fakahaaʻi maʻuaipē ʻa e icon."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ngaahi shortcut keyboard"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "ʻOku ʻomi ʻe he extension ni ha menu ʻoku lava ke fokotuʻu ʻoku fakahaaʻi ai ʻa e tokolahi taha ʻo e ngaahi emoji; ʻi he lomiʻi ha emoji ʻoku kopi ia ki he clipboard."


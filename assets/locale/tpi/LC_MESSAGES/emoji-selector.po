msgid "Modifier keys must be between chevrons"
msgstr "Ol modifaia ki i mas stap namel long ol chevron"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Dispela vailu i stap olsem oltaim em %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "No ken yusim wanpela shortcut bilong kibod we i stap pinis."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Yusim wanpela shortcut bilong kibod long op o pasim menu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Shortcut bilong kibod"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Dispela i no wanpela stret shortcut bilong kibod"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lista bilong ol stret nem bilong ki"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Soim aikon oltaim long panel"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Sapos yu go long menu wantaim shortcut bilong kibod, yu no mas soim aikon oltaim."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ol shortcut bilong kibod"


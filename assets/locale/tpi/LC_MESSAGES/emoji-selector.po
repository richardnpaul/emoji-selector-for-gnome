msgid "General layout"
msgstr "Olgeta layout"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Gutpela moa long soim intafes i kam long daunbilo sapos yu yusim wanpela panel long daunbilo, i no long antap olsem oltaim."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Antap i go daunbilo"

#: src/prefs.ts
msgid "From bottom to top"

#: src/prefs.ts
msgid "General layout"
msgstr "ئومۇمىي ئورۇنلاشتۇرۇش"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "ئەگەر سۈكۈتتىكى ئۈستۈنكى بالداق ئورنىغا ئاستىنقى تاختا ئىشلەتسىڭىز، ئارايۈزنى ئاستىدىن كۆرسەتكىنىڭىز ياخشى."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "ئۈستىدىن ئاستىغا"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "ئاستىدىن ئۈستىگە"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "تەڭشەكنى ساقلىغىلى بولمىدى"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "ھەر قۇردىكى ئېموجى سانى"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ئېموجى چوڭلۇقى (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "ئورۇنلاشتۇرۇش"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "ئۆزگەرتكۈچ كۇنۇپكىلار بۇلۇڭلۇق تىرناق ئىچىدە بولۇشى كېرەك"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "سۈكۈتتىكى قىممەت %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "مەۋجۇت بولغان ھەرپتاختا تېزلەتمىسىنى ئىشلەتمەڭ."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "تىزىملىكنى ئېچىش ۋە ياپىش ئۈچۈن ھەرپتاختا تېزلەتمىسىنى ئىشلىتىش"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "ھەرپتاختا تېزلەتمىسى"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "بۇ ئۈنۈملۈك ھەرپتاختا تېزلەتمىسى ئەمەس"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "ئۈنۈملۈك كۇنۇپكا ناملىرى تىزىمى"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "سىنبەلگىنى ھەمىشە تاختىدا كۆرسەت"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "تىزىملىكنى ھەرپتاختا تېزلەتمىسى بىلەن ئاچسىڭىز، سىنبەلگىنى ھەمىشە كۆرسىتىشنىڭ ھاجىتى يوق."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "ھەرپتاختا باغلىمىلىرى"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "بۇ كېڭەيتمە تەڭشىگىلى بولىدىغان قاڭقىش تىزىملىك تەمىنلەيدۇ، ئۇ كۆپلىگەن ئېموجىلارنى كۆرسىتىدۇ؛ ئېموجىنى چەككەندە ئۇ چاپلاش تاختىسىغا كۆچۈرۈلىدۇ."


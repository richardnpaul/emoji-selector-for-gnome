#: src/prefs.ts
msgid "General layout"
msgstr "عمومی خاکہ"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "اگر آپ ڈیفالٹ اوپری بار کی بجائے نچلا پینل استعمال کرتے ہیں تو انٹرفیس کو نیچے سے دکھانا بہتر ہے۔"

#: src/prefs.ts
msgid "From top to bottom"
msgstr "اوپر سے نیچے"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "نیچے سے اوپر"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "ترتیب محفوظ نہیں کی جا سکی"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "فی سطر ایموجیز کی تعداد"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "ایموجیز کا سائز (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "خاکہ"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "ترمیمی کلیدیں زاویائی قوسین کے درمیان ہونی چاہئیں"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "ڈیفالٹ قدر %s ہے"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "ایسا کی بورڈ شارٹ کٹ استعمال نہ کریں جو پہلے سے موجود ہو۔"

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "مینو کھولنے اور بند کرنے کے لیے کی بورڈ شارٹ کٹ استعمال کریں"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "کی بورڈ شارٹ کٹ"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "یہ درست کی بورڈ شارٹ کٹ نہیں ہے"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "درست کلیدی ناموں کی فہرست"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "آئیکن کو پینل میں ہمیشہ دکھائیں"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "اگر آپ مینو تک کی بورڈ شارٹ کٹ سے رسائی حاصل کرتے ہیں تو آئیکن کو ہمیشہ دکھانے کی ضرورت نہیں۔"

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "کی بورڈ شارٹ کٹس"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."

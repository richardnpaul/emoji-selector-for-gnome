#: src/prefs.ts
msgid "General layout"
msgstr "Umumiy joylashuv"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Agar standart yuqori panel oʻrniga pastki paneldan foydalansangiz, interfeysni pastdan koʻrsatgan maʼqul."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Yuqoridan pastga"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Pastdan yuqoriga"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Sozlamani saqlab boʻlmadi"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Har qatordagi emojilar soni"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Emojilar oʻlchami (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Joylashuv"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Modifikator tugmalari burchakli qavslar ichida boʻlishi kerak"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Standart qiymat — %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Allaqachon mavjud boʻlgan tezkor tugmalar birikmasini ishlatmang."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Menyuni ochish va yopish uchun tezkor tugmalar birikmasidan foydalanish"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Tezkor tugmalar birikmasi"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Bu yaroqli tezkor tugmalar birikmasi emas"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Yaroqli tugma nomlari roʻyxati"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Belgini panelda doim koʻrsatish"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Menyuga tezkor tugmalar birikmasi orqali kirsangiz, belgini doim koʻrsatish shart emas."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Tezkor tugmalar"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Ushbu kengaytma koʻpchilik emojilarni koʻrsatuvchi sozlanuvchi qalqib chiquvchi menyuni taqdim etadi, emojini bosish uni vaqtinchalik xotiraga nusxalaydi."


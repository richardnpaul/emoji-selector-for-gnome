msgstr "Emoji大小(单位为px)"

#: src/prefs.ts
msgid "Layout"
msgstr "布局"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "修饰键必须放在尖括号中"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "默认值为 %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "请勿使用已存在的键盘快捷键。"

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "使用快捷键触发Emoji菜单"


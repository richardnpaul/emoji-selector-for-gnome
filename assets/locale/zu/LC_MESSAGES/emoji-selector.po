#: src/prefs.ts
msgid "General layout"
msgstr "Isakhiwo jikelele"

#: src/prefs.ts
msgid "Displaying the interface from the bottom is better if you use a bottom panel instead of the default top bar."
msgstr "Kungcono ukubonisa isixhumi esibonakalayo kusukela phansi uma usebenzisa iphaneli engezansi esikhundleni sebha ephezulu ezenzakalelayo."

#: src/prefs.ts
msgid "From top to bottom"
msgstr "Kusukela phezulu kuya phansi"

#: src/prefs.ts
msgid "From bottom to top"
msgstr "Kusukela phansi kuya phezulu"

#: src/prefs.ts
msgid "The setting could not be saved"
msgstr "Lesi sethingi asikwazanga ukulondolozwa"

#: src/prefs.ts
msgid "Number of emojis per line"
msgstr "Inani lama-emoji emgqeni ngamunye"

#: src/prefs.ts
msgid "Size of emojis (px)"
msgstr "Usayizi wama-emoji (px)"

#: src/prefs.ts
msgid "Layout"
msgstr "Isakhiwo"

#: src/prefs.ts
msgid "Modifier keys must be between chevrons"
msgstr "Okhiye bokuguqula kufanele babe phakathi kwezimpawu < >"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "Inani elizenzakalelayo ngu-%s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Ungasebenzisi isinqumelo sekhibhodi esivele sikhona."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Sebenzisa isinqumelo sekhibhodi ukuvula nokuvala imenyu"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Isinqumelo sekhibhodi"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Lesi akusona isinqumelo sekhibhodi esivumelekile"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Uhlu lwamagama okhiye avumelekile"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Njalo bonisa isithonjana epanelini"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Uma uvula imenyu ngesinqumelo sekhibhodi, awudingi ukubonisa isithonjana njalo."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Ukuhlanganiswa kwekhibhodi"

#: src/prefs.ts src/lib/emojiMenu.ts
msgid "Emoji Selector"
msgstr "Emoji Selector"

#: src/prefs.ts
msgid "This extension provides a configurable popup menu displaying most emojis, clicking on an emoji copies it to the clipboard."
msgstr "Lesi sandiso sinikeza imenyu evelelayo elungisekayo ebonisa ama-emoji amaningi; ukuchofoza i-emoji kuyayikopisha ku-clipboard."


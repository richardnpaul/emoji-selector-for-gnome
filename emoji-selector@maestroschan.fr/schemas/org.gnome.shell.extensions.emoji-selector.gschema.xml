<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="emoji-selector">
	<schema id="org.gnome.shell.extensions.emoji-selector"
	path="/org/gnome/shell/extensions/emoji-selector/">
    <key type="s" name="position">
      <default>'top'</default>
      <choices>
        <choice value="top" />
        <choice value="bottom" />
      </choices>
      <summary>orientation of the interface</summary>
      <description>Possible values can be 'top' or 'bottom'.</description>
    </key>
    <key type="i" name="nbcols">
      <default>11</default>
      <range min="10" max="60" />
      <summary>Number of emojis per line</summary>
      <description>Sets the number of column of emojis to display.</description>
    </key>
    <key type="i" name="emojisize">
      <default>30</default>
      <range min="10" max="100" />
      <summary>Default size of emojis</summary>
      <description>Default size of emojis (px) ; doesn't concern recently used items</description>
    </key>
    <key type="as" name="recently-used">
      <default>
        ['😂','❤️','😍','😭','😊','😒','😘','😩','🤔','☺️',
        '👌','😔','😏','😁','😉','👍','😱','😳','😎','👀','💩']
      </default>
      <summary>default memorized emojis</summary>
      <description></description>
    </key>
    <key type="b" name="use-keybinding">
      <default>true</default>
      <summary>if keybinding is enabled</summary>
      <description>if true, Super+Period will toggle the menu.</description>
    </key>
    <key type="b" name="always-show">
      <default>true</default>
      <summary>if icon should always be shown</summary>
      <description>if false, Super+Period will be the only way to display the popup menu.</description>
    </key>
    <key type="i" name="skin-tone">
      <default>0</default>
      <range min="0" max="5" />
      <summary>Favorite skin tone</summary>
      <description>0 is none, 1 is light, ..., 5 is dark.</description>
    </key>
    <key type="i" name="gender">
      <default>0</default>
      <range min="0" max="2" />
      <summary>Favorite gender</summary>
      <description>0 is none, 1 is women, 2 is men.</description>
    </key>
    <key name="emoji-keybinding" type="as">
      <default><![CDATA[['<Super>period']]]></default>
      <summary>Keyboard shortcut.</summary>
      <description>Keyboard shortcut which opens the extension's menu.</description>
    </key>
	</schema>
</schemalist>

msgid "Modifier keys must be between chevrons"
msgstr "Las tòcas modificatrises devon èsser entre parentèsis angularas"

#: src/prefs.ts
#, javascript-format
msgid "The default value is %s"
msgstr "La valor per defaut es %s"

#: src/prefs.ts
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Utilizetz pas un acorchi de clavièr que ja existís."

#: src/prefs.ts
msgid "Use a keyboard shortcut to toggle the menu"
msgstr "Utilizar un acorchi de clavièr per afichar o amagar lo menut"

#: src/prefs.ts
msgid "Keyboard shortcut"
msgstr "Acorchi de clavièr"

#: src/prefs.ts
msgid "This is not a valid keyboard shortcut"
msgstr "Aquò es pas un acorchi de clavièr valid"

#: src/prefs.ts
msgid "List of valid key names"
msgstr "Lista dels noms de tòca validés"

#: src/prefs.ts
msgid "Always show the icon in the panel"
msgstr "Totjorn afichar l'icòna dins lo panèl"

#: src/prefs.ts
msgid "If you access the menu with the keyboard shortcut, you don't need to always display the icon."
msgstr "Se dobrissètz lo menut amb l'acorchi de clavièr, avètz pas besonh d'afichar totjorn l'icòna."

#: src/prefs.ts
msgid "Keyboard bindings"
msgstr "Acorchis de clavièr"

